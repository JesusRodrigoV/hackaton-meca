# Application
ENVIRONMENT=development
API_V1_PREFIX=/api/v1
TIMEZONE=America/La_Paz

# Database
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/meca_db

# JWT / tokens
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
CHANGE_PASSWORD_TOKEN_EXPIRE_MINUTES=10
TWO_FACTOR_SESSION_EXPIRE_MINUTES=5
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# Refresh cookie
REFRESH_COOKIE_NAME=meca_refresh_token
# Leave empty to derive from ENVIRONMENT (true only in production).
REFRESH_COOKIE_SECURE=
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/api/v1/auth

# 2FA / TOTP
TOTP_ISSUER=MECA
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOTP_ENCRYPTION_KEY=replace-with-a-valid-fernet-key
BACKUP_CODE_COUNT=5

# Login lockout
MAX_FAILED_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=5

# Email (SMTP only)
MAIL_ENABLED=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_SSL_TLS=false
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=MECA
FRONTEND_RESET_PASSWORD_URL=http://localhost:4200/reset-password

# CORS (comma-separated or JSON array)
CORS_ORIGINS=http://localhost:4200

# Redis (optional; in-memory fallback is used if unavailable)
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Files
MEDIA_DIR=./media
REPORTS_DIR=./media/reports